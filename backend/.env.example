# Postgres connection string from your Neon project (Dashboard -> Connection Details).
# Keep "?sslmode=require" at the end -- Neon requires SSL.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/expenseflow?sslmode=require

# signs login tokens, optional locally (a random one gets saved to .secret_key)
SECRET_KEY=change-me

# extra frontend urls allowed by cors, comma separated. localhost:5173 is always allowed
ALLOWED_ORIGINS=
